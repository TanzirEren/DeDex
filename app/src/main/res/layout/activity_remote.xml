<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remote Unpack"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="Runs the GitHub Actions memory-dump workflow and pulls back the result"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="GitHub settings" android:textColor="@color/text" android:textStyle="bold"
            android:layout_marginTop="6dp" android:layout_marginBottom="6dp" />

        <EditText android:id="@+id/etToken" android:layout_width="match_parent" android:layout_height="48dp"
            android:hint="Fine-grained PAT (github_pat_...)" android:inputType="textPassword"
            android:background="@drawable/card" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:textColor="@color/text" android:textColorHint="@color/muted" android:textSize="13sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <EditText android:id="@+id/etOwner" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:hint="owner" android:background="@drawable/card" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:textColor="@color/text" android:textColorHint="@color/muted" android:textSize="13sp"
                android:layout_marginEnd="5dp" />
            <EditText android:id="@+id/etRepo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:hint="repo" android:background="@drawable/card" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:textColor="@color/text" android:textColorHint="@color/muted" android:textSize="13sp"
                android:layout_marginStart="5dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <EditText android:id="@+id/etWorkflow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:hint="workflow file, e.g. memory-dump.yml" android:background="@drawable/card"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:textColor="@color/text" android:textColorHint="@color/muted" android:textSize="13sp"
                android:layout_marginEnd="5dp" />
            <EditText android:id="@+id/etBranch" android:layout_width="90dp" android:layout_height="48dp"
                android:hint="branch" android:background="@drawable/card" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:textColor="@color/text" android:textColorHint="@color/muted" android:textSize="13sp"
                android:layout_marginStart="5dp" />
        </LinearLayout>

        <Button android:id="@+id/btnSaveSettings" android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="10dp" android:background="@drawable/btn_ghost" android:text="Save settings"
            android:textAllCaps="false" android:textColor="@color/text" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke"
            android:layout_marginTop="16dp" android:layout_marginBottom="16dp" />

        <Button android:id="@+id/btnPickApk" android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/btn_primary" android:text="Select protected APK"
            android:textAllCaps="false" android:textColor="@color/accent_dark" android:textStyle="bold" />

        <TextView android:id="@+id/tvApk" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:background="@drawable/card" android:padding="14dp"
            android:text="No APK selected" android:textColor="@color/text" android:textSize="14sp" />

        <Button android:id="@+id/btnFetch" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="12dp" android:background="@drawable/btn_primary"
            android:text="Fetch: run on GitHub and pull DEX back"
            android:textAllCaps="false" android:textColor="@color/accent_dark" android:textStyle="bold" />

        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:indeterminate="true" android:visibility="gone" />

        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:background="@drawable/card" android:fontFamily="monospace"
            android:padding="14dp" android:text="Idle." android:textColor="@color/muted"
            android:textIsSelectable="true" android:textSize="12sp" />

        <Button android:id="@+id/btnSaveResult" android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="12dp" android:background="@drawable/btn_ghost" android:text="Save recovered DEX as ZIP"
            android:textAllCaps="false" android:textColor="@color/text" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
